# Option A: local MongoDB (or any full connection string)
MONGODB_URI=mongodb://localhost:27017/terri-quintel-astrology

# Option B: MongoDB Atlas — comment out MONGODB_URI above and fill these in.
# DB_HOST is the cluster address from Atlas > Connect > Drivers (the part after "@").
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=cluster0.xxxxx.mongodb.net
# DB_NAME=terri-quintel-astrology
